---
import "@/styles/global.css"

interface Props {
  title?: string;
}

const { title = "nix-darwin" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="nix-darwin configuration options search" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-black">
    <slot />
  </body>
</html>
